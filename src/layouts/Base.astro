---
import { href, previewBase } from "../lib/links";
import "../styles/global.css";
import { leagues } from "../lib/data";

interface Props {
  title: string;
  description: string;
  active?: "grafico" | "scorigamis" | "times" | "timelapse" | "sobre";
  /** Liga da página; os links do menu levam a ela. */
  liga?: string;
  /** Mostra abas para trocar de liga na mesma seção (ex.: "scorigamis"). */
  switchTo?: string;
  /** Página "Geral" (todas as competições) da seção de abas. */
  geral?: boolean;
}
const { title, description, active, switchTo, geral } = Astro.props;
const liga = Astro.props.liga ?? leagues[0].slug;
const nav = [
  { id: "grafico", label: "Gráfico", href: href("") },
  { id: "scorigamis", label: "Scorigamis", href: href(Astro.props.liga ? `${liga}/scorigamis` : "scorigamis") },
  { id: "times", label: "Times", href: href(`${liga}/times`) },
  { id: "timelapse", label: "Time-lapse", href: href("timelapse") },
];
const fullTitle = title === "Scorigami FC" ? title : `${title} | Scorigami FC`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = previewBase(Astro.url.pathname);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    {base && <base href={base} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Aplica o tema salvo antes de pintar a página, para não piscar.
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@ScorigamiFC" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" href={href("favicon.svg").replace(/\.html$/, "")} type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <a class="brand" href={href("")}>Scorigami FC</a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={active === n.id ? "page" : undefined}>{n.label}</a>)}
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Alternar modo escuro" title="Modo escuro"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
      </nav>
    </header>
    <main>
      {
        switchTo && leagues.length > 1 && (
          <nav class="league-tabs" aria-label="Competição">
            {switchTo === "scorigamis" && (
              <a href={href("scorigamis")} aria-current={geral ? "page" : undefined}>Geral</a>
            )}
            {leagues.map((l) => (
              <a href={href(`${l.slug}/${switchTo}`)} aria-current={!geral && l.slug === liga ? "page" : undefined}>{l.short}</a>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
    <footer class="site">
      <p>Novas scorigamis no X: <a href="https://x.com/ScorigamiFC">@ScorigamiFC</a></p>
      <p><a href={href("sobre")}>Sobre, regras e fontes dos dados</a></p>
    </footer>
    <script>
      import { initTooltip } from "../scripts/tooltip";
      initTooltip();
      // Modo escuro: alterna entre claro e escuro e guarda a escolha neste navegador.
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
