---
import { href, previewBase } from "../lib/links";
import { HTML_LANG, LANG_LABEL, LANG_SHORT, LANGS, t, type Lang } from "../lib/i18n";
import "../styles/global.css";
import { leagues } from "../lib/data";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  active?: "grafico" | "scorigamis" | "times" | "timelapse" | "sobre";
  /** Liga da página; os links do menu levam a ela. */
  liga?: string;
  /** Mostra abas para trocar de liga na mesma seção (ex.: "scorigamis"). */
  switchTo?: string;
  /** Página "Geral" (todas as competições) da seção de abas. */
  geral?: boolean;
}
const { lang, title, description, active, switchTo, geral } = Astro.props;
const T = t(lang);
const h = (path: string) => href(path, lang);
const liga = Astro.props.liga ?? leagues[0].slug;
const nav = [
  { id: "grafico", label: T.nav.grafico, href: h("") },
  { id: "scorigamis", label: T.nav.scorigamis, href: h(Astro.props.liga ? `${liga}/scorigamis` : "scorigamis") },
  { id: "times", label: T.nav.times, href: h(`${liga}/times`) },
  { id: "timelapse", label: T.nav.timelapse, href: h("timelapse") },
];
// A mesma página nos outros idiomas: o caminho sem o prefixo do idioma.
const rest = Astro.url.pathname
  .replace(/^\/+/, "")
  .replace(/\.html$/, "")
  .replace(/^(en|es)(\/|$)/, "")
  .replace(/(^|\/)index$/, "")
  .replace(/\/$/, "");
const alternates = LANGS.map((l) => ({ lang: l, href: href(rest, l) }));
const fullTitle = title === "Scorigami FC" ? title : `${title} | Scorigami FC`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = previewBase(Astro.url.pathname);
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    {base && <base href={base} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Aplica o tema salvo antes de pintar a página, para não piscar.
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={HTML_LANG[a.lang]} href={new URL(href(rest, a.lang).replace(/\.html$/, ""), Astro.site)} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@ScorigamiFC" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" href={href("favicon.svg").replace(/\.html$/, "")} type="image/svg+xml" />
  </head>
  <body>
    <header class="site">
      <a class="brand" href={h("")}>Scorigami FC</a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={active === n.id ? "page" : undefined}>{n.label}</a>)}
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label={T.themeLabel} title={T.themeTitle}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
        <span class="langs" role="group" aria-label={T.langLabel}>
          {alternates.map((a) => (
            <a href={a.href} hreflang={HTML_LANG[a.lang]} lang={HTML_LANG[a.lang]} title={LANG_LABEL[a.lang]} aria-current={a.lang === lang ? "true" : undefined} data-lang-link>{LANG_SHORT[a.lang]}</a>
          ))}
        </span>
      </nav>
    </header>
    <main>
      {
        switchTo && leagues.length > 1 && (
          <nav class="league-tabs" aria-label={T.competition}>
            {switchTo === "scorigamis" && (
              <a href={h("scorigamis")} aria-current={geral ? "page" : undefined}>{T.general}</a>
            )}
            {leagues.map((l) => (
              <a href={h(`${l.slug}/${switchTo}`)} aria-current={!geral && l.slug === liga ? "page" : undefined}>{l.short}</a>
            ))}
          </nav>
        )
      }
      <slot />
    </main>
    <footer class="site">
      <p>{T.footerX} <a href="https://x.com/ScorigamiFC">@ScorigamiFC</a></p>
      <p><a href={h("sobre")}>{T.footerAbout}</a> · <a href={h("ajuste")} id="report-link">{T.footerReport}</a></p>
    </footer>
    <script>
      import { initTooltip } from "../scripts/tooltip";
      initTooltip();
      // O link "Solicitar ajuste" leva a página atual junto, para dar contexto ao pedido.
      const report = document.getElementById("report-link") as HTMLAnchorElement | null;
      if (report && !location.pathname.includes("ajuste")) {
        const u = new URL(report.href);
        u.searchParams.set("pagina", location.pathname.split("/").slice(-2).join("/") + location.search);
        report.href = u.toString();
      }
      // Os links de idioma levam os filtros e a página atual (?liga=...) junto.
      document.querySelectorAll<HTMLAnchorElement>("[data-lang-link]").forEach((a) => {
        a.addEventListener("click", () => {
          if (location.search) a.href = a.href.split("?")[0] + location.search;
        });
      });
      // Modo escuro: alterna entre claro e escuro e guarda a escolha neste navegador.
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
