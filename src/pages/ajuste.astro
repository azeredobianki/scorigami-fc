---
// Formulário para o visitante apontar um erro nos dados.
import Base from "../layouts/Base.astro";
import { leagues } from "../lib/data";
---

<Base title="Solicitar ajuste" description="Achou um placar errado, um jogo faltando ou um nome trocado? Conte pra gente." active="sobre">
  <div class="prose">
    <h1>Solicitar ajuste</h1>
    <p>
      Achou um placar errado, um jogo faltando, uma data trocada ou o nome de um time diferente? Conte o que viu. Cada pedido
      é conferido com as fontes antes de mudar qualquer coisa no site.
    </p>
  </div>

  <form class="report" id="report">
    <label>
      <span>O que está errado</span>
      <select name="tipo" required>
        <option value="placar">Placar errado</option>
        <option value="faltando">Jogo faltando</option>
        <option value="sobrando">Jogo que não deveria estar</option>
        <option value="data">Data errada</option>
        <option value="time">Nome ou dados de um time</option>
        <option value="site">Problema no site</option>
        <option value="outro">Outro</option>
      </select>
    </label>
    <label>
      <span>Competição</span>
      <select name="liga">
        <option value="">Não sei / várias</option>
        {leagues.map((l) => <option value={l.slug}>{l.short}</option>)}
      </select>
    </label>
    <label>
      <span>Jogo ou página <small>(opcional)</small></span>
      <input name="jogo" maxlength="200" placeholder="Ex.: Santos 7–4 Bahia, 22/10/2003" />
    </label>
    <label>
      <span>Descrição</span>
      <textarea name="descricao" required minlength="10" maxlength="2000" rows="5" placeholder="O que aparece no site e o que deveria aparecer. Se tiver uma fonte, cole o link."></textarea>
    </label>
    <label>
      <span>Contato <small>(opcional, se quiser resposta)</small></span>
      <input name="contato" maxlength="200" placeholder="E-mail ou @ no X" />
    </label>
    <input type="hidden" name="pagina" />
    <button type="submit">Enviar</button>
    <p class="report-status" id="report-status" role="status" aria-live="polite"></p>
  </form>

  <script>
    import { initReport } from "../scripts/report";
    initReport();
  </script>
</Base>
