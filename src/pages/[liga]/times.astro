---
import Base from "../../layouts/Base.astro";
import { club, league, leagueMatches, leagues, seasonOf, g } from "../../lib/data";
import { clubPageHref } from "../../lib/links";

export function getStaticPaths() {
  return leagues.map((l) => ({ params: { liga: l.slug } }));
}

const { liga } = Astro.params as { liga: string };
const lg = league(liga);
const all = leagueMatches(liga);
const current = all.reduce((x, m) => Math.max(x, m.season), 0);
const S = (s: number) => seasonOf(liga, s);
const seasonsOf = new Map<string, Set<number>>();
for (const m of all)
  for (const c of [m.home, m.away]) {
    const s = seasonsOf.get(c) ?? new Set<number>();
    s.add(m.season);
    seasonsOf.set(c, s);
  }
const rows = [...seasonsOf.entries()]
  .map(([slug, set]) => {
    const seasons = [...set].sort((a, b) => a - b);
    const c = club(slug);
    const old = (c.names ?? []).map((n) => n.name).filter((n) => n !== c.name);
    const first = seasons[0];
    const last = seasons[seasons.length - 1];
    return {
      slug,
      name: c.name,
      state: c.state,
      old,
      count: seasons.length,
      years: last === current ? `${S(first)}–hoje` : first === last ? S(first) : `${S(first)}–${S(last)}`,
      now: last === current,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, "pt-BR"));
const groups = [
  { title: `${g(lg, "No", "Na")} ${lg.short} ${S(current)}`, rows: rows.filter((r) => r.now) },
  { title: "Já disputaram", rows: rows.filter((r) => !r.now) },
];
---

<Base title={`Times ${g(lg, "do", "da")} ${lg.short}`} description={`Os ${rows.length} clubes que já disputaram ${g(lg, "o", "a")} ${lg.name}, com as scorigamis de cada um.`} active="times" liga={liga} switchTo="times">
  <h1>Times {g(lg, "do", "da")} {lg.short}</h1>
  <p class="lede">As scorigamis de cada um dos {rows.length} clubes que já jogaram {g(lg, "o", "a")} {lg.short}, com os anos da primeira e da última participação.</p>
  {
    groups.map((g) => (
      <>
        <h2>{g.title}</h2>
        <ul class="team-list">
          {g.rows.map((r) => (
            <li>
              <a href={clubPageHref(liga, r.slug)}>{r.name}</a>
              <span class="years">{r.years} · {r.count} {r.count === 1 ? "temporada" : "temporadas"}</span>
              {r.old.length > 0 && <span class="formerly">Antes: {r.old.join(", ")}</span>}
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Base>
