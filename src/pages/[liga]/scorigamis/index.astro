---
import Base from "../../../layouts/Base.astro";
import { scorigamis } from "../../../lib/core";
import { serverCtx } from "../../../lib/ctx";
import { league, leagueMatches, leagues, seasonOf, g } from "../../../lib/data";
import { seasonHref } from "../../../lib/links";
import { plural, scorigamiListHtml } from "../../../lib/render";

export function getStaticPaths() {
  return leagues.map((l) => ({ params: { liga: l.slug } }));
}

const { liga } = Astro.params as { liga: string };
const lg = league(liga);
const all = leagueMatches(liga);
const list = scorigamis(all);
const ctx = serverCtx(liga);
const seasons = [...new Set(all.map((m) => m.season))].sort((a, b) => a - b);
const perSeason = seasons.map((s) => ({ season: s, count: list.filter((m) => m.season === s).length }));
const max = Math.max(1, ...perSeason.map((p) => p.count));
const top = [...perSeason].sort((x, y) => y.count - x.count || x.season - y.season)[0];
const latest = perSeason[perSeason.length - 1];
const lastNew = list[list.length - 1];
const decades: number[] = [];
for (let d = Math.ceil(seasons[0] / 10) * 10; d <= seasons[seasons.length - 1]; d += 10) decades.push(d);
const S = (s: number) => seasonOf(liga, s);
// Posição da década na faixa de barras (anos sem campeonato, como nas guerras, contam a temporada seguinte).
const pos = (d: number) => ((seasons.findIndex((s) => s >= d) + 0.5) / seasons.length) * 100;
---

<Base
  title={`Scorigamis ${g(lg, "do", "da")} ${lg.short}`}
  description={`Os ${list.length} placares inéditos da história ${g(lg, "do", "da")} ${lg.name}, do mais recente ao primeiro, temporada por temporada.`}
  active="scorigamis"
  liga={liga}
  switchTo="scorigamis"
>
  <h1>Scorigamis</h1>

  <h2>Mais recentes</h2>
  <Fragment set:html={scorigamiListHtml(ctx, list.slice(-25).reverse())} />

  <h2>Por temporada</h2>
  <p>
    Placares novos a cada temporada. As primeiras edições preencheram o gráfico depressa; {S(top.season)} teve mais, com{" "}
    {top.count}. A temporada atual, {S(latest.season)}, tem {latest.count}. A última scorigami {g(lg, "do", "da")} {lg.short} foi em{" "}
    {S(lastNew.season)}.
  </p>
  <div class="seasons" role="img" aria-label="Scorigamis por temporada">
    {perSeason.map((p) => (
      <a
        href={seasonHref(liga, p.season)}
        style={`height:${p.count ? Math.max(2, (p.count / max) * 100) : 0}%`}
        data-k={S(p.season)}
        data-tip={plural(p.count, "scorigami", "scorigamis")}
        aria-label={`${S(p.season)}: ${plural(p.count, "scorigami", "scorigamis")}`}
      />
    ))}
  </div>
  <div class="decades" aria-hidden="true">
    {decades.map((d) => <span style={`left:${pos(d)}%`}>{d}</span>)}
  </div>

  <ul class="season-list">
    {[...perSeason].reverse().map((p) => (
      <li><a href={seasonHref(liga, p.season)}>{S(p.season)}</a> <span class="muted">{p.count}</span></li>
    ))}
  </ul>
</Base>
