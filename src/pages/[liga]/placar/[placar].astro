---
import { href } from "../../../lib/links";
import Base from "../../../layouts/Base.astro";
import { buildCells, gridSize, scoreKey, unseenPlausible, yearsSince, type Match } from "../../../lib/core";
import { serverCtx } from "../../../lib/ctx";
import { lastDate, league, leagueMatches, leagues } from "../../../lib/data";
import { fmtDate, fmtInt, gridHtml, legendHtml, matchLine, plural } from "../../../lib/render";

export function getStaticPaths() {
  return leagues.flatMap((l) => {
    const n = Math.max(gridSize(leagueMatches(l.slug)), 10);
    const paths = [];
    for (let a = 0; a <= n; a++) for (let b = 0; b <= a; b++) paths.push({ params: { liga: l.slug, placar: `${a}-${b}` } });
    return paths;
  });
}

const { liga, placar } = Astro.params as { liga: string; placar: string };
const [a, b] = placar.split("-").map(Number);
const lg = league(liga);
const all = leagueMatches(liga);
const ctx = serverCtx(liga);
const cells = buildCells(all, "norm");
const games: Match[] = all.filter((m) => scoreKey(m) === placar).reverse();
const count = games.length;
const draw = a === b;
const homeWins = games.filter((m) => m.hg > m.ag).length;
const awayWins = games.filter((m) => m.ag > m.hg).length;
const first = games[games.length - 1];
const last = games[0];
const years = last ? yearsSince(last.date, lastDate) : 0;
const unseen = count ? undefined : unseenPlausible(all, cells, 30).find((u) => u.a === a && u.b === b);
const LIMIT = 100;

const neighbors: { a: number; b: number; count: number }[] = [];
for (let da = -1; da <= 1; da++)
  for (let db = -1; db <= 1; db++) {
    const na = a + da;
    const nb = b + db;
    if ((da || db) && na >= 0 && nb >= 0 && nb <= na) neighbors.push({ a: na, b: nb, count: cells.get(`${na}-${nb}`)?.count ?? 0 });
  }

const bySeason = new Map<number, number>();
for (const m of games) bySeason.set(m.season, (bySeason.get(m.season) ?? 0) + 1);

const title = `Já houve ${a}–${b} no ${lg.short}?`;
const description = count
  ? `Sim: o placar ${a}–${b} aconteceu ${plural(count, "vez", "vezes")} no ${lg.name}, a última em ${fmtDate(last.date)}.`
  : `Nunca: o placar ${a}–${b} ainda não aconteceu no ${lg.name}.`;
---

<Base title={title} description={description}>
  <p class="muted"><a href={href(`?liga=${liga}`)}>{lg.flag} {lg.short}</a> · Placar</p>
  <h1>{title}</h1>
  {
    count ? (
      <p class="answer">Sim, {plural(count, "vez", "vezes")}.</p>
    ) : (
      <p class="answer never">Nunca. Seria uma scorigami.</p>
    )
  }

  <div class="split">
    <section>
      {
        count > 0 && (
          <div class="stats">
            <div class="stat"><b>{fmtInt(count)}</b><span>jogos com {a}–{b}</span></div>
            {draw ? (
              <div class="stat"><b>{((count / all.length) * 100).toFixed(2).replace(".", ",")}%</b><span>dos jogos da liga</span></div>
            ) : (
              <>
                <div class="stat"><b>{fmtInt(homeWins)}</b><span>vitórias do mandante</span></div>
                <div class="stat"><b>{fmtInt(awayWins)}</b><span>vitórias do visitante</span></div>
              </>
            )}
            <div class="stat"><b>{first.season}</b><span>primeira vez</span></div>
            <div class="stat"><b>{years < 1 ? "< 1" : years}</b><span>{years === 1 ? "ano" : "anos"} desde a última</span></div>
          </div>
        )
      }
      {
        unseen && (
          <p class="lede">
            Pela média de gols do {lg.short}, a chance estimada de um jogo terminar {a}–{b} é de cerca de 1 em{" "}
            {fmtInt(Math.round(1 / unseen.probability))}.
          </p>
        )
      }

      {
        count > 0 && (
          <>
            <h2>Primeira e última vez</h2>
            <ul class="games">
              <li><span class="muted">Primeira</span> <span set:html={matchLine(ctx, first)} /> <span class="muted">{fmtDate(first.date)}</span></li>
              {count > 1 && <li><span class="muted">Última</span> <span set:html={matchLine(ctx, last)} /> <span class="muted">{fmtDate(last.date)}</span></li>}
            </ul>
            <h2>Todos os jogos {count > LIMIT && <span class="muted">(os {LIMIT} mais recentes)</span>}</h2>
            <ul class="games">
              {games.slice(0, LIMIT).map((m) => (
                <li>
                  <span set:html={matchLine(ctx, m)} />
                  <span class="muted">{fmtDate(m.date)} · {m.season}{m.note && ` · ${m.note}`}</span>
                </li>
              ))}
            </ul>
            {count > LIMIT && (
              <>
                <h2>Por temporada</h2>
                <p>
                  {[...bySeason.entries()].sort((x, y) => y[0] - x[0]).map(([s, n], i) => (
                    <>{i > 0 && " · "}<a href={href(`${liga}/scorigamis/${s}`)}>{s}</a>: {n}</>
                  ))}
                </p>
              </>
            )}
          </>
        )
      }
    </section>
    <aside>
      <section class="panel">
        <h2>No gráfico</h2>
        <Fragment set:html={gridHtml(ctx, all, { mode: "norm", ring: new Set([placar]), numbers: false })} />
        <Fragment set:html={legendHtml()} />
      </section>
      <section class="panel">
        <h2>Placares vizinhos</h2>
        <ul class="plain">
          {neighbors.map((n) => (
            <li>
              <a class="chip" href={href(`${liga}/placar/${n.a}-${n.b}`)}>{n.a}–{n.b}</a>{" "}
              <span class="muted">{n.count ? plural(n.count, "jogo", "jogos") : "nunca"}</span>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Base>
