---
import Base from "../../../layouts/Base.astro";
import { serverCtx } from "../../../lib/ctx";
import { league, leagueMatches, leagues } from "../../../lib/data";
import { PREVIEW } from "../../../lib/links";
import { scoreKeys, scorePage } from "../../../lib/pages";

export function getStaticPaths() {
  if (PREVIEW) return [];
  return leagues.flatMap((l) => scoreKeys(leagueMatches(l.slug)).map((placar) => ({ params: { liga: l.slug, placar } })));
}

const { liga, placar } = Astro.params as { liga: string; placar: string };
const page = scorePage(serverCtx(liga), league(liga), leagueMatches(liga), placar);
---

<Base title={page.title} description={page.description} liga={liga}>
  <Fragment set:html={page.html} />
</Base>
