---
import Base from "../layouts/Base.astro";
import { buildCells, scorigamis } from "../lib/core";
import { serverCtx } from "../lib/ctx";
import { clubs, lastDate, leagues, matches } from "../lib/data";
import { eras } from "../lib/eras";
import { href } from "../lib/links";
import { fmtInt, fmtLong, gridHtml, highlightsHtml, legendHtml, scorigamiListHtml, topScoresHtml } from "../lib/render";

const ctx = serverCtx("todas");
const europe = (() => {
  const xs = leagues.filter((l) => l.slug !== "brasileirao" && l.slug !== "mls").map((l) => (l.slug === "premier-league" ? `${l.short} (desde ${l.since})` : l.short));
  return xs.length > 1 ? `${xs.slice(0, -1).join(", ")} e ${xs[xs.length - 1]}` : xs[0];
})();
const cells = buildCells(matches, "norm");
const recent = scorigamis(matches, "norm", true).slice(-5).reverse();
const seasons = [...new Set(matches.map((m) => m.season))].sort((a, b) => a - b);
const eraList = eras(seasons);
// Times agrupados por liga no filtro.
const clubGroups = leagues.map((l) => {
  const playing = new Set(matches.filter((m) => m.league === l.slug).flatMap((m) => [m.home, m.away]));
  return { league: l, clubs: clubs.filter((c) => playing.has(c.slug)).sort((a, b) => a.name.localeCompare(b.name, "pt-BR")) };
});
---

<Base
  title="Scorigami FC"
  description="Todos os placares finais da história do Brasileirão e das principais ligas europeias e da MLS em um gráfico: quais já aconteceram, quantas vezes e quais nunca aconteceram."
  active="grafico"
>
  <form class="filters" id="filters" onsubmit="return false" aria-label="Filtros do gráfico">
    <div class="field">
      <span class="field-label" id="lbl-liga">Competições</span>
      <details class="multi" data-name="liga">
        <summary aria-labelledby="lbl-liga"><span class="sum">Geral: todas</span></summary>
        <div class="menu">
          {leagues.map((l) => <label><input type="checkbox" name="liga" value={l.slug} /> {l.short}</label>)}
          <button type="button" class="clear">Limpar</button>
        </div>
      </details>
    </div>
    <div class="field">
      <span class="field-label" id="lbl-time">Times</span>
      <details class="multi" data-name="time">
        <summary aria-labelledby="lbl-time"><span class="sum">Todos</span></summary>
        <div class="menu wide">
          <input type="search" class="find" placeholder="Buscar time" aria-label="Buscar time" />
          {clubGroups.map((g) => (
            <fieldset data-league={g.league.slug}>
              <legend>{g.league.short}</legend>
              {g.clubs.map((c) => <label><input type="checkbox" name="time" value={c.slug} /> {c.name}</label>)}
            </fieldset>
          ))}
          <button type="button" class="clear">Limpar</button>
        </div>
      </details>
    </div>
    <div class="field">
      <span class="field-label" id="lbl-era">Eras</span>
      <details class="multi" data-name="era">
        <summary aria-labelledby="lbl-era"><span class="sum">Todas</span></summary>
        <div class="menu" id="era-menu">
          {eraList.slice(1).map((e) => <label><input type="checkbox" name="era" value={e.id} /> {e.label}</label>)}
          <button type="button" class="clear">Limpar</button>
        </div>
      </details>
    </div>
    <div class="field">
      <span class="field-label">Gráfico</span>
      <div class="switch" role="group" aria-label="Tipo de gráfico">
        <button type="button" data-mode="norm" aria-pressed="true">Maior × menor</button>
        <button type="button" data-mode="mando" aria-pressed="false">Mandante × visitante</button>
      </div>
    </div>
    <div class="field">
      <span class="field-label">Cor das casas</span>
      <div class="switch" role="group" aria-label="Cor das casas">
        <button type="button" data-color="freq" aria-pressed="true">Frequência</button>
        <button type="button" data-color="first" aria-pressed="false">Primeira vez</button>
      </div>
    </div>
  </form>

  <div class="status">
    <span id="counter">Exibindo <b>{fmtInt(matches.length)}</b> / {fmtInt(matches.length)} jogos</span>
    <span>Último jogo: {fmtLong(lastDate)}</span>
  </div>

  <div id="grid" set:html={gridHtml(ctx, matches, { mode: "norm" })} />
  <div id="legend" set:html={legendHtml()} />

  <h2>O que é Scorigami?</h2>
  <p>
    Este gráfico mostra todos os placares finais da história do Brasileirão, desde a Taça Brasil de 1959, e das
    principais ligas europeias ({europe}), além da MLS desde 1996. Também mostra todos os placares que ainda não aconteceram. Escolha uma competição no filtro para ver só ela. Uma <b>scorigami</b> é um placar que nunca tinha acontecido antes: no filtro Geral, em nenhuma das competições; com uma
    liga escolhida, naquela liga. O site acompanha cada placar
    novo e quantas vezes cada um já se repetiu. A ideia vem do <a href="https://nflscorigami.com/">NFL Scorigami</a>, criado
    por Jon Bois.
  </p>

  <h2>Como ler este gráfico?</h2>
  <p>
    O placar do vencedor fica no eixo vertical, à esquerda, e o do perdedor no eixo horizontal, embaixo. Empates ficam na
    diagonal. Na cor "Frequência", quanto mais escura a casa, mais vezes o placar aconteceu; na cor "Primeira vez",
    quanto mais escura, mais recente foi a primeira vez daquele placar. As casas em branco são placares que nunca aconteceram. A
    metade de cima à direita fica vazia porque o perdedor não pode ter feito mais gols que o vencedor. No modo
    mandante × visitante, 3–1 e 1–3 viram casas diferentes. Passe o mouse para ver os números e clique numa casa para ver
    os jogos.
  </p>

  <h2 id="recent-title">Últimas scorigamis em todas as competições</h2>
  <div id="recent" set:html={scorigamiListHtml(ctx, recent)} />
  <a class="more" id="all-scorigamis" href={href("scorigamis")}>Todas as scorigamis, recentes e por temporada →</a>

  <h2>Destaques</h2>
  <div id="highlights" set:html={highlightsHtml(ctx, matches)} />

  <h2>Placares mais frequentes</h2>
  <div id="top" set:html={topScoresHtml(ctx, cells)} />

  <script>
    import { initHome } from "../scripts/home";
    initHome();
  </script>
</Base>
