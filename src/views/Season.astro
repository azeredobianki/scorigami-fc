---
import Base from "../layouts/Base.astro";
import { serverCtx } from "../lib/ctx";
import { league, leagueMatches } from "../lib/data";
import type { Lang } from "../lib/i18n";
import { seasonPage } from "../lib/pages";

const { lang, liga, ano } = Astro.props as { lang: Lang; liga: string; ano: string };
const season = Number(ano);
const all = leagueMatches(liga);
// Torneios da temporada quando ela teve mais de um: Taça Brasil e Robertão no Brasileirão antigo;
// Apertura e Clausura, Metropolitano e Nacional etc. na Argentina e no México ("Clausura: semifinal").
// Nessas duas ligas, o nome do torneio vem com inicial maiúscula e a fase sozinha, em minúscula.
const stages = [
  ...new Set(
    all
      .filter((m) => m.season === season)
      .map((m) => (liga === "brasileirao" ? m.stage?.split(" - ")[0] : m.stage?.split(":")[0]))
      .filter((s): s is string => !!s && (liga === "brasileirao" ? /Taça|Robertão/.test(s) : /^\p{Lu}/u.test(s))),
  ),
];
const page = seasonPage(serverCtx(liga, lang), league(liga), all, season, stages);
---

<Base lang={lang} title={page.title} description={page.description} active="scorigamis" liga={liga}>
  <Fragment set:html={page.html} />
</Base>
